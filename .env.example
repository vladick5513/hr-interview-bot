BOT_TOKEN=your_bot_token
# Telegram user id рекрутеров, JSON-список: [123456789] или [111,222]
HR_IDS=[123456789]

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=http://localhost:8000/v1

# Приложение с dev.hh.ru. Без него резюме и вакансии принимаются только файлом .txt
# HH_CLIENT_ID=your_hh_client_id
# HH_CLIENT_SECRET=your_hh_client_secret
# HH_REDIRECT_URI=https://your-domain.example/hh/callback
HH_USER_AGENT=hr-interview-bot/0.1 (your_email@example.com)

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_pass
DB_NAME=hr_interview_bot

LOG_LEVEL=INFO
